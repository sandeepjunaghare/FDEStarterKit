# Copy to .env (gitignored) and fill in. Render: set the same keys under Environment.

# Required. Supabase → Connect → Direct → Session pooler (port 5432). URL-encode special
# characters in the password; single-quote the value.
DATABASE_URL='postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require'

# LLM (Claude Agent SDK)
ANTHROPIC_API_KEY=

# Embeddings: Voyage AI (Anthropic's recommended provider). The pgvector column must be vector(EMBEDDING_DIM).
# Check: uv run --script scripts/check_embeddings.py
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# Evals: the faithfulness judge uses ANTHROPIC_API_KEY above
EVAL_JUDGE_MODEL=claude-haiku-4-5

# Evals and tracing (Langfuse)
# LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
# SDK v4 reads LANGFUSE_BASE_URL (not LANGFUSE_HOST)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com




# UI → API (Streamlit service)
API_URL=http://localhost:8000

# Optional: only if using supabase-py (Storage, Auth). The API itself uses DATABASE_URL.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=
